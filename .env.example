# 複製此檔為 .env 並填入實際值
# cp .env.example .env

# ── 資料庫密碼（docker-compose 用）──────────────────────────────────────────
DB_PASSWORD=your_db_password_here

# ── LINE Bot ────────────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── 系統設定 ─────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=admin
SECRET_KEY=
MOBILE_JWT_SECRET=
ANTHROPIC_API_KEY=

# ── 自訂 Domain ───────────────────────────────────────────────────────────────
RENDER_EXTERNAL_URL=https://lin-punch-system.crownai.ink
WEBAUTHN_RP_ID=lin-punch-system.crownai.ink
WEBAUTHN_ORIGIN=https://lin-punch-system.crownai.ink
